pipeline {
    agent { label 'Windows-Agent' }
    
    triggers {
        cron('H 3 * * *') // Run every day at 3:00 AM 
        pollSCM('H/2 * * * *')          // Optional: fallback polling
       
    }

    environment {
        VCENTER_SERVER = 'VC Server Address'
        SCRIPT_NAME = 'Datacenter_Snapshot_Remove.ps1'
        GIT_REPO = 'GIT Repo'
        BRANCH_NAME = 'main'
    }

    stages {
        stage('Clone GitLab Repo') {
            steps {
                // Clone from GitLab
                git branch: "${env.BRANCH_NAME}", url: "${env.GIT_REPO}"
            }
        }

        stage('Run PowerShell 7 Script') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'Creds ID IN jENKINS ',
                    usernameVariable: 'VC_USERNAME',
                    passwordVariable: 'VC_PASSWORD'
                )]) {
                    bat """
                        echo ==== DEBUG: Listing workspace contents ====
                        dir

                        echo ==== DEBUG: Checking if script exists ====
                        if not exist "%SCRIPT_NAME%" (
                            echo ERROR: Script not found: %SCRIPT_NAME%
                            exit 1
                        )

                        echo ==== Running PowerShell 7 Script ====
                        pwsh -NoLogo -NoProfile -ExecutionPolicy Bypass -File "%SCRIPT_NAME%" -vCenter "%VCENTER_SERVER%" -Username "%VC_USERNAME%" -Password "%VC_PASSWORD%"
                    """
                }
            }
        }
    }
}
